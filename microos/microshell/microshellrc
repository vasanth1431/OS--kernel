# Colors
export C_RESET='\[\033[0m\]'
export C_BOLD='\[\033[1m\]'
export C_TEAL='\[\033[38;5;39m\]'
export C_GRAPHITE='\[\033[38;5;240m\]'
export C_AMBER='\[\033[38;5;214m\]'
export C_GREEN='\[\033[38;5;76m\]'
export C_RED='\[\033[38;5;196m\]'
export C_WHITE='\[\033[38;5;255m\]'

# Git branch parser for prompt
parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}

# Prompt appearance: user@microos:~/projects$ [git_branch]
PS1="${C_BOLD}${C_TEAL}\u@microos${C_RESET}:${C_AMBER}\w${C_GREEN}\$(parse_git_branch)${C_RESET}${C_TEAL}\$ ${C_RESET}"

# Standard Aliases
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias df='df -h'
alias free='free -h'

# MicroOS Aliases
alias info='micro-info'
alias status='micro-status'
alias health='micro-health'
alias net='micro-network'
alias wifi='micro-wifi'
alias myip='micro-ip'
alias internet='micro-internet'
alias ps-micro='micro-process'
alias storage='micro-storage'
alias apps='micro-apps'
alias update='micro-update'
alias help-micro='micro-help'

