#!/usr/bin/env bash
# micro-health: Show resource consumption and basic system warnings
set -euo pipefail

C_TEAL='\033[38;5;39m'
C_AMBER='\033[38;5;214m'
C_GREEN='\033[38;5;76m'
C_RED='\033[38;5;196m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}                MICROOS SYSTEM HEALTH                 ${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"

WARNINGS=0

# Check Memory Health
if [ -f /proc/meminfo ]; then
    MEM_TOTAL=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
    MEM_AVAIL=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
    MEM_PCT=$(( (MEM_TOTAL - MEM_AVAIL) * 100 / MEM_TOTAL ))
    
    if [ "$MEM_PCT" -ge 90 ]; then
        echo -e "${C_RED}[CRITICAL] Memory utilization is very high: ${MEM_PCT}%!${C_RESET}"
        WARNINGS=$((WARNINGS + 1))
    elif [ "$MEM_PCT" -ge 75 ]; then
        echo -e "${C_AMBER}[WARNING] Memory utilization elevated: ${MEM_PCT}%${C_RESET}"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "${C_GREEN}[HEALTHY] Memory utilization nominal: ${MEM_PCT}%${C_RESET}"
    fi
fi

# Check Disk Health
DISK_PCT=$(df / | awk 'NR==2 {gsub("%",""); print $5}')
if [ "$DISK_PCT" -ge 90 ]; then
    echo -e "${C_RED}[CRITICAL] Root storage critically low: ${DISK_PCT}% used!${C_RESET}"
    WARNINGS=$((WARNINGS + 1))
elif [ "$DISK_PCT" -ge 80 ]; then
    echo -e "${C_AMBER}[WARNING] Root storage getting full: ${DISK_PCT}% used${C_RESET}"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${C_GREEN}[HEALTHY] Root storage space nominal: ${DISK_PCT}% used${C_RESET}"
fi

# Check CPU Load Health
CORES=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null || echo 1)
LOAD_1M=$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo 0.0)
LOAD_INT=${LOAD_1M%.*}
if [ "$LOAD_INT" -gt "$CORES" ]; then
    echo -e "${C_AMBER}[WARNING] High CPU load average (${LOAD_1M}) exceeds core count (${CORES})${C_RESET}"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${C_GREEN}[HEALTHY] CPU load average (${LOAD_1M}) well within capacity (${CORES} cores)${C_RESET}"
fi

# Check Zombie / Defunct Processes
ZOMBIES=$(ps -eo stat | grep -c 'Z' || true)
if [ "$ZOMBIES" -gt 0 ]; then
    echo -e "${C_AMBER}[WARNING] Detected ${ZOMBIES} zombie process(es)${C_RESET}"
    WARNINGS=$((WARNINGS + 1))
else
    echo -e "${C_GREEN}[HEALTHY] Zero zombie processes detected${C_RESET}"
fi

echo -e "------------------------------------------------------"
if [ "$WARNINGS" -eq 0 ]; then
    echo -e "${C_BOLD}${C_GREEN}Overall Status: EXCELLENT - All system health checks passed.${C_RESET}"
else
    echo -e "${C_BOLD}${C_AMBER}Overall Status: ATTENTION REQUIRED - ${WARNINGS} warning(s) flagged.${C_RESET}"
fi
echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
