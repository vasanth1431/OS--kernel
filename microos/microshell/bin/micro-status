#!/usr/bin/env bash
# micro-status: Display real CPU, memory, disk and uptime information
set -euo pipefail

C_TEAL='\033[38;5;39m'
C_AMBER='\033[38;5;214m'
C_GREEN='\033[38;5;76m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}               MICROOS REAL-TIME STATUS               ${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"

# CPU Load Average
LOAD=$(awk '{print $1", "$2", "$3}' /proc/loadavg 2>/dev/null || uptime | awk -F'load average:' '{print $2}')
echo -e "${C_AMBER}[CPU Load Averages]${C_RESET} 1m, 5m, 15m: ${LOAD}"

# Memory Usage from /proc/meminfo
if [ -f /proc/meminfo ]; then
    MEM_TOTAL=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
    MEM_AVAIL=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
    MEM_USED=$((MEM_TOTAL - MEM_AVAIL))
    MEM_PCT=$((MEM_USED * 100 / (MEM_TOTAL > 0 ? MEM_TOTAL : 1)))
    echo -e "${C_AMBER}[RAM Usage]${C_RESET}         ${MEM_USED} MB / ${MEM_TOTAL} MB (${MEM_PCT}% utilized)"
    
    SWAP_TOTAL=$(awk '/SwapTotal/ {print int($2/1024)}' /proc/meminfo)
    SWAP_FREE=$(awk '/SwapFree/ {print int($2/1024)}' /proc/meminfo)
    SWAP_USED=$((SWAP_TOTAL - SWAP_FREE))
    echo -e "${C_AMBER}[Swap Usage]${C_RESET}        ${SWAP_USED} MB / ${SWAP_TOTAL} MB"
fi

# Disk Usage
echo -e "\n${C_AMBER}[Root Storage Status]${C_RESET}"
df -h / | awk 'NR==1{printf " %-12s %-8s %-8s %-8s %-6s %s\n", $1, $2, $3, $4, $5, $6} NR==2{printf " %-12s %-8s %-8s %-8s %-6s %s\n", $1, $2, $3, $4, $5, $6}'

# Top Processes
echo -e "\n${C_AMBER}[Top 3 Processes by CPU]${C_RESET}"
ps -eo pid,user,%cpu,%mem,comm --sort=-%cpu | head -n 4

echo -e "\n${C_GREEN}System Uptime:${C_RESET} $(uptime -p 2>/dev/null || uptime)"
echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
