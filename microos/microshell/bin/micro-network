#!/usr/bin/env bash
# micro-network: Display network interface status and active connections
set -euo pipefail

C_TEAL='\033[38;5;39m'
C_AMBER='\033[38;5;214m'
C_GREEN='\033[38;5;76m'
C_RED='\033[38;5;196m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}              MICROOS NETWORK INTERFACES              ${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"

if command -v nmcli &>/dev/null; then
    echo -e "${C_AMBER}[NetworkManager Device Status]${C_RESET}"
    nmcli device status || true
    echo
    echo -e "${C_AMBER}[Active Network Connections]${C_RESET}"
    nmcli connection show --active || true
else
    echo -e "${C_AMBER}[Kernel Network Interfaces (ip link)]${C_RESET}"
    ip -br link show
fi

echo
echo -e "${C_AMBER}[IP Addresses & CIDR]${C_RESET}"
ip -br addr show

echo
echo -e "${C_AMBER}[Default Routing Table]${C_RESET}"
ip route show default || echo "No default route established."

echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
