#!/usr/bin/env bash
# micro-ip: Display actual IP addresses and routing information
set -euo pipefail

C_TEAL='\033[38;5;39m'
C_AMBER='\033[38;5;214m'
C_GREEN='\033[38;5;76m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}             MICROOS IP ADDRESS & ROUTING             ${C_RESET}"
echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"

echo -e "${C_AMBER}[Local Network Interfaces & Addresses]${C_RESET}"
ip -4 -o addr show | awk '{printf " Interface: %-10s IP: %-18s\n", $2, $4}'

echo
echo -e "${C_AMBER}[Default Gateway]${C_RESET}"
ip route show default || echo "No default route found."

echo
echo -e "${C_AMBER}[Configured DNS Nameservers]${C_RESET}"
if [ -f /etc/resolv.conf ]; then
    grep "^nameserver" /etc/resolv.conf || echo "No nameservers found in /etc/resolv.conf"
fi

echo
echo -e "${C_AMBER}[Public IP Address (External Query)]${C_RESET}"
if command -v curl &>/dev/null; then
    PUB_IP=$(curl -s --connect-timeout 2 https://api.ipify.org 2>/dev/null || echo "Unavailable (Offline or firewall)")
    echo " Public IP: $PUB_IP"
else
    echo " curl not installed."
fi

echo -e "${C_BOLD}${C_TEAL}======================================================${C_RESET}"
